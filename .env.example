# Configure privately in Vercel. Never commit a real key.
# Groq is preferred when GROQ_API_KEY is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional legacy provider: used only when GROQ_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
